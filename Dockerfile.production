# Multi-stage build for optimized Docker image
FROM node:22-bookworm-slim AS builder

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install all dependencies (including dev for build)
RUN npm ci

# Copy source code
COPY . .

# Build TypeScript
RUN npm run build

# Production stage
FROM node:22-bookworm-slim

# Install runtime dependencies (postgresql-client and openssh-client)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    postgresql-client \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install only production dependencies
RUN npm ci --production && \
    npm cache clean --force

# Copy built files from builder
COPY --from=builder /app/dist ./dist

# Create backup directory
RUN mkdir -p /backups

# Create non-root user for security
# If UID 1000 exists, use it; otherwise create user with UID 1000
RUN (getent passwd 1000 >/dev/null && \
     (getent passwd shuttle >/dev/null || useradd -m -u 1000 shuttle)) || \
    useradd -m -u 1000 shuttle 2>/dev/null || \
    useradd -m shuttle && \
    chown -R shuttle:shuttle /app /backups 2>/dev/null || \
    chown -R 1000:1000 /app /backups

USER shuttle

# Entry point
ENTRYPOINT ["node", "dist/index.js"]

