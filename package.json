{
  "name": "@claquettes/shuttle",
  "version": "2.0.0",
  "description": "PostgreSQL backup tool with SSH transfer",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "shuttle": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "docker:build": "docker build -f Dockerfile.production -t shuttle:latest .",
    "docker:tag": "docker tag shuttle:latest",
    "publish:docker": "npm run docker:build",
    "test": "bash tests/run.sh",
    "test:full": "bash tests/run.sh --full"
  },
  "keywords": [
    "postgresql",
    "backup",
    "pg_dump",
    "ssh",
    "sftp",
    "database",
    "cron",
    "scheduled-backup"
  ],
  "author": "Claquettes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Claquettes/shuttle.git"
  },
  "homepage": "https://github.com/Claquettes/shuttle#readme",
  "bugs": {
    "url": "https://github.com/Claquettes/shuttle/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.4.1",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
