{
  "version": 1,
  "shuttle": {
    "name": "my-prod-shuttle",
    "timezone": "Europe/Paris",
    "connections": {
      "source": "prod_main",
      "target": "prod_backup"
    },
    "jobs": [
      {
        "name": "full-nightly",
        "type": "full",
        "cron": "0 3 * * *",
        "format": "custom",
        "compress": true,
        "keepLast": 7
      },
      {
        "name": "tables-frequent",
        "type": "tables",
        "cron": "*/30 * * * *",
        "tables": [
          "public.users",
          "public.orders"
        ],
        "format": "plain",
        "compress": true,
        "keepLast": 48
      }
    ]
  }
}

